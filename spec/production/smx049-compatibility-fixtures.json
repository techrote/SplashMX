{
  "schema": "splashmx.smx049-compatibility-programme/1",
  "issue": "SMX-049/#74",
  "authority": [
    "docs/architecture/ARCHITECTURE-V1.md",
    "docs/implementation/SMX-024-CANONICAL-SERIALIZATION.md",
