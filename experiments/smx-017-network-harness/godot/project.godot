; SMX-017 trusted topology harness only. Canonical creation semantics live in creation.json.
config_version=5

[application]
config/name="SplashMX SMX-017 Topology Harness"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.025, 1)

[network]
limits/max_packet_bytes=8192
